<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Client.ViewModels"
             x:Class="Client.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
        <StackPanel Margin="10" Spacing="10">
            <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
            
            <!-- Log Management Section -->
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10">
                <StackPanel Spacing="10">
                    <TextBlock Text="Log Management" FontSize="18" FontWeight="SemiBold"/>
                    
                    <TextBlock Text="View application logs to diagnose issues and crashes." 
                               TextWrapping="Wrap" FontSize="12" Foreground="Gray"/>
                    
                    <TextBlock Text="{Binding LogDirectoryPath}" 
                               TextWrapping="Wrap" FontSize="11" Foreground="DarkGray" 
                               IsVisible="{Binding ShowLogPath}"/>
                    
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="View Logs" 
                                Command="{Binding ViewLogsCommand}"
                                Width="120"/>
                        <Button Content="Refresh" 
                                Command="{Binding RefreshLogsCommand}"
                                Width="100"/>
                        <Button Content="Clear Logs" 
                                Command="{Binding ClearLogsCommand}"
                                Width="100"/>
                        <Button Content="Share Logs" 
                                Command="{Binding ShareLogsCommand}"
                                Width="120"
                                IsVisible="{Binding CanShareLogs}"/>
                    </StackPanel>
                    
                    <!-- Log Viewer -->
                    <Border Background="#F5F5F5" 
                            BorderBrush="Gray" 
                            BorderThickness="1" 
                            CornerRadius="3" 
                            Padding="5"
                            MaxHeight="400"
                            IsVisible="{Binding ShowLogContent}">
                        <ScrollViewer>
                            <TextBox Text="{Binding LogContent}" 
                                     IsReadOnly="True" 
                                     TextWrapping="Wrap"
                                     FontFamily="Courier New"
                                     FontSize="10"
                                     Background="Transparent"
                                     BorderThickness="0"/>
                        </ScrollViewer>
                    </Border>
                    
                    <TextBlock Text="{Binding LogStatusMessage}" 
                               FontSize="11" 
                               Foreground="Green"
                               IsVisible="{Binding ShowLogStatus}"/>
                </StackPanel>
            </Border>

            <!-- App Information Section -->
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10">
                <StackPanel Spacing="5">
                    <TextBlock Text="Application Information" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding AppVersion}" FontSize="12"/>
                    <TextBlock Text="{Binding PlatformInfo}" FontSize="12"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</UserControl>
