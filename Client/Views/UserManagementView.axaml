<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Client.ViewModels"
             xmlns:converters="using:Client.Converters"
             x:Class="Client.Views.UserManagementView"
             x:DataType="vm:UserManagementViewModel">

    <Grid RowDefinitions="Auto,*" Margin="10">
        <TextBlock Grid.Row="0" Text="User Management" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
        
        <Grid Grid.Row="1" ColumnDefinitions="2*,*">
            <!-- User List -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,10,0">
                <Grid RowDefinitions="*">
                    <DataGrid Grid.Row="0" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="80"/>
                            <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                            <DataGridTextColumn Header="Last Executed" Binding="{Binding LastExecutedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150"/>
                            <DataGridTemplateColumn Header="Actions" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Button Command="{Binding $parent[DataGrid].((vm:UserManagementViewModel)DataContext).ToggleEnabledCommand}" 
                                                    CommandParameter="{Binding}" 
                                                    Width="40" Height="30">
                                                <Button.Content>
                                                    <TextBlock Text="{Binding IsEnabled, Converter={x:Static converters:ObjectConverters.EnabledToIcon}}"/>
                                                </Button.Content>
                                                <ToolTip.Tip>
                                                    <TextBlock Text="{Binding IsEnabled, Converter={x:Static converters:ObjectConverters.EnabledToTooltip}}"/>
                                                </ToolTip.Tip>
                                            </Button>
                                            <Button Content="✏️" Command="{Binding $parent[DataGrid].((vm:UserManagementViewModel)DataContext).EditUserCommand}" CommandParameter="{Binding}" Width="35" Height="30" ToolTip.Tip="Edit User"/>
                                            <Button Content="🗑️" Command="{Binding $parent[DataGrid].((vm:UserManagementViewModel)DataContext).DeleteUserCommand}" CommandParameter="{Binding}" Width="35" Height="30" ToolTip.Tip="Delete User"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Edit Form -->
            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Padding="10">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding SelectedUser, Converter={x:Static converters:ObjectConverters.IsNull}}" 
                               FontSize="16" FontWeight="Bold"/>
                    
                    <TextBlock Text="Username:"/>
                    <TextBox Text="{Binding Username}"/>
                    
                    <TextBlock Text="Password:"/>
                    <TextBox Text="{Binding Password}" PasswordChar="*"/>
                    
                    <TextBlock Text="Display Name (optional):"/>
                    <TextBox Text="{Binding DisplayName}"/>
                    
                    <CheckBox Content="Enabled" IsChecked="{Binding IsEnabled}"/>
                    
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                        <Button Content="💾 Save" Command="{Binding SaveUserCommand}"/>
                        <Button Content="❌ Cancel" Command="{Binding CancelEditCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>

</UserControl>
