# Environment variables for Docker deployment

# Touker.com credentials (required)
USERNAME=your_username_here
PASSWORD=your_password_here

# Transaction password for creating arbitrage (required - no default)
PWD=your_transaction_password_here

# Purchase time for arbitrage orders (default: 14:15)
PURCHASE_TIME=14:15

# Max investment per stock holder per fund in yuan (default: 1000)
MAX_INVESTMENT=1000

# Retry delay in seconds between workflow attempts (default: 60)
# After each workflow completion (success or failure), wait this many seconds before retrying
RETRY_DELAY_SECONDS=60

# Optional: API URL (default: http://server:8080 for Docker Compose)
# API_URL=http://server:8080

# Optional: Run browser in headless mode
# In development mode (DOTNET_ENVIRONMENT=Development), defaults to false (UI visible)
# In production mode, defaults to true (headless)
# Set explicitly to override default behavior:
# HEADLESS=true

# Optional: Set to Development to show browser UI by default
# DOTNET_ENVIRONMENT=Development
# Or:
# ASPNETCORE_ENVIRONMENT=Development

